PORT=4200
SERVER_URL=http://localhost:4200
UPLOAD_DIR=uploads

MAX_UPLOAD_SIZE=524288000   # 500 MB
CACHE_MAX_AGE=86400         # 1 day

ALLOWED_MIME_TYPES=image/

TURNSTILE_SECRET_KEY=key

# Shared secret with the frontend proxy. Lets sessions that already passed
# Turnstile skip the challenge on later uploads. Must match the frontend.
# Leave empty to disable the bypass. Keep secret.
INTERNAL_API_SECRET=
